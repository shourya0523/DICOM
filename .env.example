# Copy to .env before running `docker compose up --build`.
PROVIDER_CODE=BCH
PROVIDER_NAME=Boston Children's Hospital

# Host ports the coordinator (and you) will call.
GATEWAY_PORT=8101
NODE_PORT=8001

TOKEN_SECRET=replace-with-a-long-random-secret
SERVICE_API_KEY=replace-with-a-coordinator-shared-key

# 1 = keyword-only concept extraction (fast, no model download). 0 = live OpenMed.
OPENMED_FORCE_FALLBACK=1

# Identity the gateway presents to its own hospital node when that node enforces SSO.
# Must be on the node's allowlist and IRB-approved to receive full metadata.
NODE_SERVICE_ID=jorgenson@harvard.edu
NODE_SERVICE_ORG=Harvard University
NODE_SERVICE_IRB_APPROVED=1

# --- `docker compose --profile portal up` only --------------------------------
PORTAL_PORT=8010
COORDINATOR_PORT=5001
MGH_NODE_PORT=8002
BWH_NODE_PORT=8003
PLATFORM_JWT_SECRET=replace-with-a-platform-session-secret

# Optional — without this, coordinator skips NL filter deduction.
GEMINI_API_KEY=
