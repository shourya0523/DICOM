# Copy to .env and adjust as needed. Loaded automatically in dev.
FLASK_DEBUG=1
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=5001

# Frontend origin(s) allowed to call this API. Comma-separated, or * for all.
CORS_ORIGINS=*

# Must match each provider gateway's SERVICE_API_KEY.
SERVICE_API_KEY=demo-key

# --- Gemini (filter deduction) ---
# Fill this in. Without it, deduction is skipped and only user filters are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Hospital network ---
HOSPITAL_CODES=BCH,MGH,BWH

# --- Provider gateways (real POST /search targets) ---
GATEWAY_BCH_URL=http://localhost:8101
GATEWAY_MGH_URL=http://localhost:8102
GATEWAY_BWH_URL=http://localhost:8103
GATEWAY_TIMEOUT=30

# Legacy single-base alias (defaults to BCH gateway).
GATEWAY_BASE_URL=http://localhost:8101

# Legacy dev-only direct node URLs (used by GET /api/nodes health check only).
NODE_BCH_URL=http://localhost:8001
NODE_MGH_URL=http://localhost:8002
NODE_BWH_URL=http://localhost:8003
NODE_TIMEOUT=5
